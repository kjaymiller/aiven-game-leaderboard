DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
ADMIN_KEY=your_secret_admin_key_here

# Production Environment Variables for Score Server
# These will be configured in your hosting service

# REQUIRED: Database connection
DATABASE_URL=postgresql://username:password@your-db-host:5432/database_name

# REQUIRED: Admin console password (sign in at /admin). If unset, the console
# fails closed: /admin/login returns 503. Replace this placeholder.
# Admin and game API tokens are minted in the console's API tab and sent as
# "Authorization: Bearer <token>"; they are secrets, shown once, stored hashed.
ADMIN_KEY=your_super_secret_admin_key_here

# REQUIRED: CORS origins for your game domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# OPTIONAL: Logging level
LOG_LEVEL=INFO

# OPTIONAL: Port (if your hosting service requires specific port)
PORT=8000